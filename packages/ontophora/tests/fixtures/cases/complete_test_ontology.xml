    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#TestCase"/>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#semantics"/>
                        <owl:hasValue rdf:resource="http://www.w3.org/2007/OWL/testOntology#DIRECT"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#alternativeSemanticsTest"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#semantics"/>
                        <owl:hasValue rdf:resource="http://www.w3.org/2007/OWL/testOntology#DIRECT"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#TestCase"/>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#semantics"/>
                        <owl:hasValue rdf:resource="http://www.w3.org/2007/OWL/testOntology#RDF-BASED"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#alternativeSemanticsTest"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#semantics"/>
                        <owl:hasValue rdf:resource="http://www.w3.org/2007/OWL/testOntology#RDF-BASED"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#profile"/>
        <owl:someValuesFrom>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#EL"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#QL"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#RL"/>
                </owl:oneOf>
            </owl:Class>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#species"/>
                <owl:hasValue rdf:resource="http://www.w3.org/2007/OWL/testOntology#DL"/>
