    <!-- http://www.w3.org/2007/OWL/testOntology#ConsistencyTest -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#ConsistencyTest">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#ProfileIdentificationTest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#premiseOntology"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.w3.org/2007/OWL/testOntology#InconsistencyTest"/>
    </owl:Class>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#InconsistencyTest -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#InconsistencyTest">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#ProfileIdentificationTest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#premiseOntology"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#NegativeEntailmentTest -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#NegativeEntailmentTest">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#ConsistencyTest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#nonConclusionOntology"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#PositiveEntailmentTest -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#PositiveEntailmentTest">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#ConsistencyTest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#conclusionOntology"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#ProfileIdentificationTest -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#ProfileIdentificationTest">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#TestCase"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#inputOntology"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#Syntax -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#Syntax"/>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#SyntaxTranslationTest -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#SyntaxTranslationTest">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#TestCase"/>
    </owl:Class>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#TestCase -->

    <owl:Class rdf:about="http://www.w3.org/2007/OWL/testOntology#TestCase">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2007/OWL/testOntology#normativeSyntax"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


