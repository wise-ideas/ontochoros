    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#rdfXmlInputOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#rdfXmlInputOntology">
