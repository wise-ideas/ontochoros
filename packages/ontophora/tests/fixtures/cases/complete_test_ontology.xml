    <!-- http://www.w3.org/2007/OWL/testOntology#inputOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#inputOntology">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#nonConclusionOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#nonConclusionOntology">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#inputOntology"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#owlXmlConclusionOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#owlXmlConclusionOntology">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#conclusionOntology"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#owlXmlInputOntology"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#owlXmlInputOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#owlXmlInputOntology">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#inputOntology"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#owlXmlNonConclusionOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#owlXmlNonConclusionOntology">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#nonConclusionOntology"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#owlXmlInputOntology"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#owlXmlPremiseOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#owlXmlPremiseOntology">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#owlXmlInputOntology"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#premiseOntology"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#premiseOntology -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#premiseOntology">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2007/OWL/testOntology#inputOntology"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#rdfXmlConclusionOntology -->

