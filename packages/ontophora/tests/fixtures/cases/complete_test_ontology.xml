<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2007/OWL/testOntology#"
     xml:base="http://www.w3.org/2007/OWL/testOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
