    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2007/OWL/testOntology#alternativeSemanticsTest -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#alternativeSemanticsTest">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#importedOntology -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#importedOntology"/>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#importedOntologyIRI -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#importedOntologyIRI"/>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#issue -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#issue"/>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#normativeSyntax -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#normativeSyntax">
        <rdfs:range rdf:resource="http://www.w3.org/2007/OWL/testOntology#Syntax"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#profile -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#profile">
        <rdfs:range>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#EL"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#QL"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#RL"/>
                </owl:oneOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#semantics -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#semantics">
        <rdfs:range>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#DIRECT"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#RDF-BASED"/>
                </owl:oneOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#specRef -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#specRef"/>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#species -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#species">
        <rdfs:range>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#DL"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#FULL"/>
                </owl:oneOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2007/OWL/testOntology#status -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2007/OWL/testOntology#status">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#Approved"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#Extracredit"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#Proposed"/>
                    <rdf:Description rdf:about="http://www.w3.org/2007/OWL/testOntology#Rejected"/>
                </owl:oneOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


