<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#">
  <owl:DatatypeProperty rdf:about="http://example.org/hasAge"/>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:Datatype rdf:nodeID="unionDatatype">
    <owl:unionOf rdf:parseType="Collection">
      <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:unionOf>
  </rdfs:Datatype>
  <rdf:Description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/hasAge"/>
    <owl:allValuesFrom rdf:nodeID="unionDatatype"/>
  </rdf:Description>
  <rdf:Description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/hasAge"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</owl:hasValue>
  </rdf:Description>
</rdf:RDF>
